+#[test]
+#[ignore = "requires SATANSFIDDLE_TEST_COMPILER_300 plus debug-symbol wibo"]
+fn real_inherited_helper_masks_carry_into_the_next_unit() {
+    let compiler = PathBuf::from(env::var_os("SATANSFIDDLE_TEST_COMPILER_300").unwrap());
+    let work = Workspace::new();
+    let config = work.0.join("config.json");
+    let first = work.0.join("floating.cpp");
+    let second = work.0.join("again.cpp");
+    fs::write(&first, include_str!("floating/floating.cpp")).unwrap();
+    fs::write(&second, include_str!("floating/floating.cpp")).unwrap();
+    let run = |name: &str, extra: &str| {
+        fs::write(&config, compiler_config(&compiler, extra)).unwrap();
+        let directory = work.0.join(name);
+        fs::create_dir(&directory).unwrap();
+        let executable = env::var_os("SATANSFIDDLE_TEST_EXECUTABLE")
+            .unwrap_or_else(|| env!("CARGO_BIN_EXE_satansfiddle").into());
+        let result = Command::new(executable)
+            .env("SATANSFIDDLE_VERIFY", "1")
+            .arg("--config").arg(&config)
+            .arg("--output").arg(&directory)
+            .arg(&first).arg(&second)
+            .output().unwrap();
+        assert_success(&result);
+        let traces = String::from_utf8_lossy(&result.stderr).into_owned();
+        let entry = |unit: &str| traces.lines()
+            .find(|line| line.starts_with(&format!("satansfiddle: helper-masks {unit} ")))
+            .unwrap_or_else(|| panic!("no helper-mask trace for {unit}: {traces}"))
+            .to_owned();
+        (entry("floating.cpp"), entry("again.cpp"), fs::read(directory.join("again.o")).unwrap())
+    };
+    let (first_seeded, second_seeded, seeded) = run("seeded", "");
+    assert!(first_seeded.ends_with("gpr=0x0 fpr=0x0 seeded"), "{first_seeded}");
+    assert!(second_seeded.ends_with("gpr=0x0 fpr=0x0 seeded"), "{second_seeded}");
+    // floating.cpp's helper calls leave history that again.cpp starts from.
+    let (first_inherited, second_inherited, _) = run("inherited", "inherit_helper_masks = true");
+    assert!(first_inherited.ends_with("gpr=0x0 fpr=0x0 inherited"), "{first_inherited}");
+    assert!(second_inherited.ends_with(" inherited") && !second_inherited.contains("gpr=0x0 fpr=0x0"),
+        "the helper masks did not carry into the second unit: {second_inherited}");
+    let (_, second_pinned, pinned) = run("pinned", "inherit_helper_masks = true\n[[translation_units]]\nname = 'again.cpp'\ngpr_helper_mask = 0\nfpr_helper_mask = 0");
+    assert!(second_pinned.ends_with("gpr=0x0 fpr=0x0 seeded"), "{second_pinned}");
+    assert_eq!(seeded, pinned, "a translation_units row did not override the inherited masks");
+}
