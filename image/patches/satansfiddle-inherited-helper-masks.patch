+#[test]
+fn inherited_helper_masks_keep_rows_and_reject_defaults() {
+    let config = parse("inherit_helper_masks = true\n[[translation_units]]\nname = 'x.cpp'\ngpr_helper_mask = 0x30\nfpr_helper_mask = 0\n").unwrap();
+    assert!(config.inherit_helper_masks);
+    assert!(!parse("").unwrap().inherit_helper_masks);
+    assert!(parse("inherit_helper_masks = true\ndefault_gpr_helper_mask = 0x30\n").is_err());
+    assert!(parse("inherit_helper_masks = true\ndefault_fpr_helper_mask = 0x1000\n").is_err());
+}
