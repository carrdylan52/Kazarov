+/// Publish the objects of a multi-input run only after every one of them is complete.
+struct PendingDirectory(PathBuf);
+
+impl PendingDirectory {
+    fn new(output: &Path) -> Result<Self> {
+        for serial in 0..100 {
+            let candidate =
+                path::absolute(output)?.join(format!(".satansfiddle-{}-{serial}", std::process::id()));
+            match fs::create_dir(&candidate) {
+                Ok(()) => return Ok(Self(candidate)),
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => continue,
+                Err(error) => return Err(error).context("cannot create a temporary output directory"),
+            }
+        }
+        bail!("cannot allocate a temporary output directory")
+    }
+
+    fn publish(&self, stems: &[String], output: &Path) -> Result<()> {
+        for stem in stems {
+            let mut magic = [0; 4];
+            fs::File::open(self.0.join(format!("{stem}.o")))
+                .and_then(|mut file| file.read_exact(&mut magic))
+                .with_context(|| format!("compiler succeeded without producing {stem}.o"))?;
+            ensure!(&magic == b"\x7fELF", "compiler output {stem}.o is not an ELF object");
+        }
+        // A dependency map the compiler wrote beside an object goes with it.
+        for stem in stems {
+            for name in [format!("{stem}.o"), format!("{stem}.d")] {
+                let made = self.0.join(&name);
+                if name.ends_with(".d") && !made.is_file() {
+                    continue;
+                }
+                fs::rename(made, output.join(&name))
+                    .with_context(|| format!("cannot publish {name} to {}", output.display()))?;
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Drop for PendingDirectory {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+/// The object stem of each input; MWCC names a directory output's objects by stem.
+fn input_stems(input: &[PathBuf]) -> Result<Vec<String>> {
+    let mut stems = Vec::with_capacity(input.len());
+    for one in input {
+        let stem = one
+            .file_stem()
+            .and_then(|stem| stem.to_str())
+            .with_context(|| format!("input {} has no UTF-8 file stem", one.display()))?;
+        ensure!(!stems.iter().any(|seen| seen == stem), "two inputs share the object name {stem}.o");
+        stems.push(stem.to_owned());
+    }
+    Ok(stems)
+}
