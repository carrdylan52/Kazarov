+#[test]
+#[ignore = "requires SATANSFIDDLE_TEST_COMPILER_300 plus debug-symbol wibo"]
+fn real_several_inputs_match_their_single_runs() {
+    let compiler = PathBuf::from(env::var_os("SATANSFIDDLE_TEST_COMPILER_300").unwrap());
+    let work = Workspace::new();
+    let config = work.0.join("config.json");
+    fs::write(&config, compiler_config(&compiler, "")).unwrap();
+    let first = work.0.join("floating.cpp");
+    let second = work.0.join("again.cpp");
+    let third = work.0.join("integer.cpp");
+    fs::write(&first, include_str!("floating/floating.cpp")).unwrap();
+    fs::write(&second, include_str!("floating/floating.cpp")).unwrap();
+    fs::write(&third, include_str!("compile_sample/sample.cpp")).unwrap();
+    let together = work.0.join("together");
+    fs::create_dir(&together).unwrap();
+    assert_success(&cli_many(&[&first, &second, &third], &together, &config));
+    // The default masks are written at every unit, so one run reproduces each single run.
+    for input in [&first, &second, &third] {
+        let stem = input.file_stem().unwrap().to_str().unwrap();
+        let alone = work.0.join(format!("{stem}-alone.o"));
+        assert_success(&cli(input, &alone, &config));
+        assert_eq!(
+            fs::read(together.join(format!("{stem}.o"))).unwrap(),
+            fs::read(&alone).unwrap(),
+            "{stem}.o differs between one run and its own run"
+        );
+    }
+    assert!(fs::read_dir(&together).unwrap().all(|entry| !entry.unwrap().file_name()
+        .to_string_lossy().starts_with(".satansfiddle-")));
+
+    // Dependency maps the compiler writes beside the objects are published with them.
+    let flags = serde_json::from_str::<serde_json::Value>(&fs::read_to_string(&config).unwrap())
+        .unwrap()["compiler_options"].as_str().unwrap().to_owned() + " -MD";
+    let mut with_maps: serde_json::Value =
+        serde_json::from_str(&fs::read_to_string(&config).unwrap()).unwrap();
+    with_maps["compiler_options"] = flags.into();
+    fs::write(&config, with_maps.to_string()).unwrap();
+    let mapped = work.0.join("mapped");
+    fs::create_dir(&mapped).unwrap();
+    assert_success(&cli_many(&[&first, &third], &mapped, &config));
+    for stem in ["floating", "integer"] {
+        let map = fs::read_to_string(mapped.join(format!("{stem}.d"))).unwrap();
+        assert!(map.contains(&format!("{stem}.cpp")), "{stem}.d: {map}");
+    }
+
+    // A failing input publishes none of the run's objects.
+    let failed = work.0.join("failed");
+    fs::create_dir(&failed).unwrap();
+    let bad = work.0.join("invalid.cpp");
+    fs::write(&bad, "this is invalid C++ !\n").unwrap();
+    assert!(!cli_many(&[&first, &bad], &failed, &config).status.success());
+    assert_eq!(fs::read_dir(&failed).unwrap().count(), 0);
+}
