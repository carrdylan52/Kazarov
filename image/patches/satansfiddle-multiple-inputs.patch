+#[test]
+fn several_inputs_need_a_directory_distinct_stems_and_no_unit_name() {
+    let work = Workspace::new();
+    let config = work.0.join("config.json");
+    fs::write(&config, "{\"compiler_path\": \"/nonexistent/mwccps2.exe\"}").unwrap();
+    let first = work.0.join("first.cpp");
+    let second = work.0.join("second.cpp");
+    let nested = work.0.join("nested");
+    fs::create_dir(&nested).unwrap();
+    let same_stem = nested.join("first.cpp");
+    for path in [&first, &second, &same_stem] {
+        fs::write(path, "int value() { return 1; }\n").unwrap();
+    }
+    let reject = |result: Output, diagnostic: &str| {
+        assert!(!result.status.success());
+        let stderr = String::from_utf8_lossy(&result.stderr);
+        assert!(stderr.contains(diagnostic), "expected {diagnostic:?}: {stderr}");
+    };
+    reject(cli_many(&[&first, &second], &work.0.join("one.o"), &config), "must be a directory");
+    reject(cli_many(&[&first, &same_stem], &work.0, &config), "share the object name first.o");
+    let executable = env::var_os("SATANSFIDDLE_TEST_EXECUTABLE")
+        .unwrap_or_else(|| env!("CARGO_BIN_EXE_satansfiddle").into());
+    reject(
+        Command::new(executable)
+            .arg("--config").arg(&config)
+            .arg("--output").arg(&work.0)
+            .args(["--translation-unit", "first.cpp"])
+            .arg(&first).arg(&second)
+            .output().unwrap(),
+        "--translation-unit names a single input",
+    );
+    assert!(!work.0.join("first.o").exists() && !work.0.join("second.o").exists());
+}
